# Copy to .env at the repo root and fill in:  cp .env.example .env
# Write values unquoted - the notebook's loader takes the line verbatim, so
# KEY="abc" becomes the literal string "abc" (quotes included).
# Used by Approach 2 (louie-py) in Lab 1 and by the code track in Labs 3-4 and the capstone.
# Approach 1 (Claude Code over Splunk MCP) does NOT read this file - it uses the
# SPLUNK_* shell exports shown in the Lab 1 install block.

# --- Graphistry Hub credentials (free account: https://hub.graphistry.com) ---
# Preferred: a personal key (Hub -> Account -> Personal Keys).
GRAPHISTRY_HUB_KEY_ID=
GRAPHISTRY_HUB_KEY_SECRET=

# Alternative: username / password. Only used if GRAPHISTRY_HUB_KEY_ID is empty.
# GRAPHISTRY_USERNAME=
# GRAPHISTRY_PASSWORD=

# --- Hosts (defaults are correct for the workshop) ---
GRAPHISTRY_HOST=hub.graphistry.com
LOUIE_HOST=https://den.louie.ai
